# ZYM 0.1 语法展示程序
# 当前文件用于冻结语言设计；解释器完成后将成为第一个综合示例。

declare Student {
    name,
    scores
}.

makeFunction sum(values) {
    set total := 0.
    loop i in 0..length(values) {
        total := total + values[i].
    }
    return total.
}

makeFunction average(values) {
    when length(values) == 0 {
        return 0.
    }
    return sum(values) / length(values).
}

set student := Student {
    name: "小明",
    scores: [88, 95, 76]
}.

output "学生：" + student.name.
output "总分：" + toText(sum(student.scores)).
output "平均分：" + toText(average(student.scores)).

when average(student.scores) >= 90 {
    output "等级：优秀".
} otherwise when average(student.scores) >= 60 {
    output "等级：通过".
} otherwise {
    output "等级：未通过".
}
